{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@ficoim/shared": ["./packages/shared/src/index.ts"],
      "@ficoim/shared/backup/runtime-node": ["./packages/shared/src/backup/runtime-node.ts"],
      "@ficoim/shared/backup/runtime-universal": ["./packages/shared/src/backup/runtime-universal.ts"],
      "@ficoim/shared/testing": ["./packages/shared/src/testing/sample.ts"],
      "@ficoim/core": ["./packages/core/src/index.ts"],
      "@ficoim/core/adapters/sqlite-node": ["./packages/core/src/adapters/sqlite-node.ts"],
      "@ficoim/core/adapters/pg": ["./packages/core/src/adapters/pg.ts"],
      "@ficoim/core/adapters/expo-sqlite": ["./packages/core/src/adapters/expo-sqlite.ts"],
      "@ficoim/api": ["./packages/api/src/index.ts"],
      "@ficoim/client": ["./packages/client/src/index.ts"],
      "@ficoim/client/local": ["./packages/client/src/local.ts"],
      "@ficoim/screens": ["./packages/screens/src/index.ts"]
    }
  }
}
